{
  "rewrites": [
    { "source": "/success", "destination": "/success.html" },
    { "source": "/api/checkout", "destination": "/api/checkout.js" },
    { "source": "/api/webhook", "destination": "/api/webhook.js" },
    { "source": "/api/validate-licence", "destination": "/api/validate-licence.js" }
  ],
  "headers": [
    {
      "source": "/api/webhook",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
